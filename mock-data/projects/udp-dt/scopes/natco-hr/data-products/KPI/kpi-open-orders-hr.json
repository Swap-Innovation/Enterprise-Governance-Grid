        ]
      },
      "transformation": {
        "sql": "SELECT COUNT(*) FILTER (WHERE status IN ('pending','processing'))::float / NULLIF(COUNT(*), 0) AS open_orders_rate FROM product_orders_hr.public.narudzba",
        "dialect": "postgresql",
        "schedule": "0 4 * * *",
        "table": "product_orders_hr.public.narudzba"
      },
