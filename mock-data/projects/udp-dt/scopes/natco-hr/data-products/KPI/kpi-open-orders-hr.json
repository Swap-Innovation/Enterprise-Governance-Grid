      "natco": "natco-hr",
      "layer": "metric",
      "familyId": "product-orders",
      "version": "1.0.0",
      "characteristics": {
        "Description": "Ratio of orders in pending or processing status to total orders in NATCO Croatia.",
        "Unit": "ratio",
        "Direction": "lower_is_better",
        "Threshold": 0.22,
        "SLA": "Daily by 04:30 UTC"
      },
      "links": {
