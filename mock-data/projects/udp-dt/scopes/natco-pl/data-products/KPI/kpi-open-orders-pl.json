      "familyId": "product-orders",
      "version": "1.0.0",
      "characteristics": {
        "Description": "Ratio of orders in pending or processing status to total orders in Poland.",
        "Unit": "ratio",
        "Direction": "lower_is_better",
        "Threshold": 0.19,
        "SLA": "Daily by 04:00 UTC"
