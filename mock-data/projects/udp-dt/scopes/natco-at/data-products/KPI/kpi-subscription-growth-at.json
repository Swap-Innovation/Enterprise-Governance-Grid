{
  "pack": "products",
  "kinds": [
    "kpi"
  ],
  "scope": "natco-at",
  "contracts": {
    "kpi-subscription-growth-at": {
      "id": "kpi-subscription-growth-at",
      "contract_id": "ctr-inst-kpi-subscription-growth-at",
      "type_contract_id": "ctr-dp-type-kpi",
      "kind": "kpi",
      "asset_type": "KPI",
      "name": "Subscription MoM Growth (AT)",
      "display_name": "Subscription MoM Growth (AT)",
      "qualified_name": "kpis.kpi-subscription-growth-at",
      "source_system": "entropy_marketplace",
      "natco": "natco-at",
      "layer": "metric",
      "familyId": "service-subscriptions",
      "version": "1.0.0",
      "characteristics": {
        "Description": "Month-over-month growth rate of active service subscriptions (Austria).",
        "Unit": "ratio",
        "Direction": "higher_is_better",
        "Threshold": 0.01,
        "SLA": "Monthly by 04:30 UTC on 1st"
      },
      "links": {
        "source_data_product": "dp-service-subscriptions-at",
        "source_columns": [
          "col-service-subscriptions-at-abonnement_id",
          "col-service-subscriptions-at-status",
          "col-service-subscriptions-at-created_at"
        ],
        "table": "service_subscriptions_at.public.serviceabonnement"
      },
      "transformation": {
        "sql": "WITH curr AS (SELECT COUNT(*) c FROM service_subscriptions_at.public.serviceabonnement WHERE status = 'active'), prev AS (SELECT COUNT(*) c FROM service_subscriptions_at.public.serviceabonnement WHERE status = 'active' AND created_at < DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)) SELECT SAFE_DIVIDE(curr.c - prev.c, prev.c) AS growth_rate FROM curr, prev",
        "dialect": "bigquery",
        "schedule": "0 4 1 * *"
      },
      "metadata": {
        "pack": "data-products",
        "da": "DA-11",
        "owner": "natco-at-data-office",
        "steward": "P. Gruber",
        "sensitivity": "internal",
        "created_at": "2026-02-15",
        "updated_at": "2026-08-19"
      }
    }
  }
}
