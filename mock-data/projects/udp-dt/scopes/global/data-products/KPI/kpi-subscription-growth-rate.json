{
  "pack": "products",
  "kinds": [
    "kpi"
  ],
  "scope": "global",
  "contracts": {
    "kpi-subscription-growth-rate": {
      "id": "kpi-subscription-growth-rate",
      "contract_id": "ctr-inst-kpi-subscription-growth-rate",
      "type_contract_id": "ctr-dp-type-kpi",
      "kind": "kpi",
      "asset_type": "KPI",
      "name": "Subscription MoM Growth",
      "display_name": "Subscription MoM Growth",
      "qualified_name": "kpis.kpi-subscription-growth-rate",
      "source_system": "entropy_marketplace",
      "natco": "global",
      "layer": "metric",
      "familyId": "service-subscriptions",
      "version": "1.0.0",
      "characteristics": {
        "Description": "Month-over-month growth rate of active service subscriptions.",
        "Unit": "ratio",
        "Direction": "higher_is_better",
        "Threshold": 0.02,
        "SLA": "Monthly by 04:30 UTC on 1st"
      },
      "links": {
        "source_data_product": "dp-service-subscriptions",
        "source_columns": [
          "col-service-subscriptions-subscription_id",
          "col-service-subscriptions-status",
          "col-service-subscriptions-created_at"
        ]
      },
      "transformation": {
        "sql": "WITH curr AS (SELECT COUNT(*) c FROM dp.curated.service_subscription WHERE status = 'active'), prev AS (SELECT COUNT(*) c FROM dp.curated.service_subscription WHERE status = 'active' AND created_at < DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)) SELECT SAFE_DIVIDE(curr.c - prev.c, prev.c) AS growth_rate FROM curr, prev",
        "dialect": "bigquery",
        "schedule": "0 4 1 * *"
      },
      "metadata": {
        "pack": "data-products",
        "da": "DA-11",
        "owner": "Service Inventory Team",
        "steward": "T. Schneider",
        "sensitivity": "internal",
        "created_at": "2026-04-01",
        "updated_at": "2026-08-19"
      }
    }
  }
}
