{
  "pack": "products",
  "kinds": [
    "kpi"
  ],
  "scope": "global",
  "contracts": {
    "kpi-churn-rate": {
      "id": "kpi-churn-rate",
      "contract_id": "ctr-inst-kpi-churn-rate",
      "type_contract_id": "ctr-dp-type-kpi",
      "kind": "kpi",
      "asset_type": "KPI",
      "name": "30-Day Churn Rate",
      "display_name": "30-Day Churn Rate",
      "qualified_name": "kpis.kpi-churn-rate",
      "source_system": "entropy_marketplace",
      "natco": "global",
      "layer": "metric",
      "familyId": "customer-360",
      "version": "1.0.0",
      "characteristics": {
        "Description": "Ratio of customers churned in the last 30 days to total customers.",
        "Unit": "ratio",
        "Direction": "lower_is_better",
        "Threshold": 0.05,
        "SLA": "Daily by 03:30 UTC"
      },
      "links": {
        "source_data_product": "dp-customer-360",
        "source_columns": [
          "col-customer-360-customer_id",
          "col-customer-360-status",
          "col-customer-360-updated_at"
        ]
      },
      "transformation": {
        "sql": "SELECT SAFE_DIVIDE(COUNTIF(status = 'churned' AND updated_at >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)), COUNT(*)) AS churn_rate FROM dp.curated.customer_360",
        "dialect": "bigquery",
        "schedule": "0 3 * * *"
      },
      "metadata": {
        "pack": "data-products",
        "da": "DA-11",
        "owner": "Customer 360 Product Team",
        "steward": "M. Weber",
        "sensitivity": "internal",
        "created_at": "2026-04-01",
        "updated_at": "2026-08-19"
      }
    }
  }
}
