  "status": "draft",
  "kind": "business_catalog_hierarchy",
  "title": "Business Catalog — Hierarchy And Relations Contract",
  "doc": "01. Hierarchy And Relations.md",
  "tool_coverage_doc": "03. Catalog Tool Coverage.md",
  "layers": {
    "glossary": [
      "Business Term",
      "Acronym",
      "Glossary Category",
      "Measure",
      "KPI"
    ],
    "conceptual_canonical": [
      "Data Domain",
      "Data Concept"
    ],
    "semantic_logical": [
      "Data Model",
      "Data Entity",
      "Data Attribute"
    ],
    "context": [
      "Business Process",
      "Business Rule",
      "Policy",
      "Issue",
      "Report",
      "Report Attribute"
    ]
  },
  "canonical_chains": {
    "glossary": [
      "Glossary Category → Business Term → Acronym",
      "Measure → KPI"
    ],
    "conceptual": [
      "Data Domain",
      "Data Concept"
    ],
    "semantic": [
      "Data Model",
      "Data Entity",
      "Data Attribute"
    ],
    "context": [
      "Report → Report Attribute",
      "Business Process / Business Rule / Policy / Issue → glossary & semantic assets"
    ],
    "bridge_to_physical": [
      "Data Entity → Table",
      "Data Attribute → Column"
    ],
    "bridge_to_control_plane": [
      "Business Term|KPI|Measure|Data Entity|Data Attribute|Report Attribute → mapsTo → Registry Concept"
    ]
  },
  "relations": [
    {
      "id": "rel-category-contains-term",
      "from": "Glossary Category",
      "predicate": "contains",
      "to": "Business Term",
      "public_id": "GlossaryCategoryContainsBusinessTerm",
      "normative": true
    },
    {
      "id": "rel-measure-has-kpi",
      "from": "Measure",
      "predicate": "specialized_by",
      "to": "KPI",
      "public_id": "MeasureHasKPI",
      "normative": true
    },
    {
      "id": "rel-domain-contains-concept",
      "from": "Data Domain",
      "predicate": "contains",
      "to": "Data Concept",
      "public_id": "DataDomainContainsDataConcept",
      "normative": true
    },
    {
      "id": "rel-model-contains-entity",
      "from": "Data Model",
      "predicate": "contains",
      "to": "Data Entity",
      "public_id": "DataModelContainsDataEntity",
      "normative": true
    },
    {
      "id": "rel-entity-contains-attribute",
      "from": "Data Entity",
      "predicate": "contains",
      "to": "Data Attribute",
      "public_id": "DataEntityContainsDataAttribute",
      "normative": true
    },
    {
      "id": "rel-concept-classifies-attribute",
      "from": "Data Concept",
      "predicate": "classifies",
      "to": "Data Attribute",
      "public_id": "DataConceptClassifiesDataAttribute",
      "normative": true
    },
    {
      "id": "rel-report-contains-report-attribute",
      "from": "Report",
      "predicate": "contains",
      "to": "Report Attribute",
      "public_id": "ReportContainsReportAttribute",
      "normative": true
    },
    {
      "id": "rel-entity-implemented-in-table",
      "from": "Data Entity",
      "predicate": "implemented_in",
      "to": "Table",
      "public_id": "DataEntityImplementedInTable",
      "normative": true
    },
    {
      "id": "rel-attribute-implemented-in-column",
      "from": "Data Attribute",
      "predicate": "implemented_in",
      "to": "Column",
      "public_id": "DataAttributeImplementedInColumn",
      "normative": true
    },
    {
      "id": "rel-term-maps-to-concept",
      "from": "Business Term",
      "predicate": "mapsTo",
      "to": "Registry Concept",
      "owned_by": "mapping_engine",
      "da_contract": "DA-08",
      "normative": true
    },
    {
      "id": "rel-kpi-maps-to-concept",
      "from": "KPI",
      "predicate": "mapsTo",
      "to": "Registry Concept",
      "owned_by": "mapping_engine",
      "da_contract": "DA-08",
      "normative": true
    },
    {
      "id": "rel-entity-maps-to-concept",
      "from": "Data Entity",
      "predicate": "mapsTo",
      "to": "Registry Concept",
      "owned_by": "mapping_engine",
      "da_contract": "DA-08",
      "normative": true
    },
    {
      "id": "rel-attribute-maps-to-concept",
      "from": "Data Attribute",
      "predicate": "mapsTo",
      "to": "Registry Concept",
      "owned_by": "mapping_engine",
      "da_contract": "DA-08",
      "normative": true
    }
  ],
  "rules": [
    "Glossary SoR = Collibra (and peer glossaries); meaning SoR = Semantic Control Plane (mapsTo).",
    "Conceptual layer (Data Domain / Data Concept) is the Collibra expression of canonical business groupings.",
    "Semantic layer (Data Model / Entity / Attribute) bridges glossary/conceptual to physical Table/Column.",
    "Context layer (Process, Rule, Policy, Issue, Report) governs and consumes meaning; it does not replace Registry concepts.",
    "KPI Calculation Rule is descriptive; authoritative calculation stays beside the semantic layer (SQ1).",
    "Do not fork Registry concept definitions into glossary prose."
  ],
